# Copy this file to .env and fill in your values
# Never commit .env to git

# OpenAI API key — get from platform.openai.com
OPENAI_API_KEY=your-openai-api-key-here

# Path where Chroma stores its vector database on disk
CHROMA_DB_PATH=./chroma_db

# Name of the Chroma collection (change this when re-theming per company)
CHROMA_COLLECTION_NAME=fannie_mae_docs

# Path to the folder containing PDF files to ingest
PDF_DIRECTORY=./data/pdfs

# OpenAI models
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4173

# Set to true in local dev to enable /docs and /redoc. Never true in production.
DEBUG=false
